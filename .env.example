# Choose one provider: anthropic, azure_openai, browser_use, deepseek,
# gemini, ollama, or openai.
MCP_MODEL_PROVIDER=anthropic
MCP_MODEL_NAME=claude-sonnet-4-6
MCP_TEMPERATURE=0.3
MCP_MAX_STEPS=30
MCP_MAX_ACTIONS_PER_STEP=5
MCP_USE_VISION=true

# Set only the credential for the selected provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
BROWSER_USE_API_KEY=
DEEPSEEK_API_KEY=
AZURE_OPENAI_API_KEY=

# Optional provider endpoint overrides.
OPENAI_ENDPOINT=
ANTHROPIC_API_ENDPOINT=
DEEPSEEK_ENDPOINT=https://api.deepseek.com
OLLAMA_HOST=http://localhost:11434
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Browser defaults. Keep security enabled unless an isolated test requires otherwise.
BROWSER_USE_HEADLESS=true
BROWSER_USE_DISABLE_SECURITY=false
BROWSER_USE_ALLOWED_DOMAINS=
BROWSER_USE_CDP_URL=
BROWSER_USE_EXTRA_CHROMIUM_ARGS=
CHROME_PATH=
CHROME_PERSISTENT_SESSION=false
CHROME_USER_DATA=
CHROME_DEBUGGING_HOST=127.0.0.1
CHROME_DEBUGGING_PORT=

# Optional proxy settings.
BROWSER_USE_PROXY_URL=
BROWSER_USE_NO_PROXY=
BROWSER_USE_PROXY_USERNAME=
BROWSER_USE_PROXY_PASSWORD=
